# ==========================================
# Evolyn - Environment Configuration Template
# Duplicate this file to .env before starting services
# NEVER commit .env to version control
# ==========================================

# -----------------
# Backend (apps/api)
# -----------------
PORT=5001
NODE_ENV=development

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://evolyn:evolyn_secret@localhost:5432/evolyn_db

# Google Gemini AI Configuration (Environment-driven)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# AWS S3 Storage (Optional for local testing; mock fallback available)
AWS_REGION=us-east-1
AWS_S3_BUCKET=evolyn-guidelines-storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# -----------------
# Frontend (apps/web)
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:5001
PORT=3000
