# ==========================================
# Evolyn Web Frontend Environment Variables (apps/web)
# Configure these in Vercel Project Settings > Environment Variables
# ==========================================

# Public URL of the deployed Evolyn Backend API (HTTPS in production)
# Example: https://evolyn-api.onrender.com or https://evolyn-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:5001

# Optional Server-Side API URL for Next.js SSR / rewrites
# API_URL=http://localhost:5001
