# ==========================================
# Evolyn API Backend Environment Variables (apps/api)
# Configure these in your backend deployment service (Render / Railway / Vercel)
# ==========================================

PORT=5001
NODE_ENV=production

# Neon PostgreSQL Connection Strings (Must include ?sslmode=require)
# DATABASE_URL: Pooled connection string (ep-...-pooler.region.neon.tech/neondb?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-your-db-pooler.region.neon.tech/neondb?sslmode=require

# DIRECT_URL: Direct unpooled compute connection for schema migrations
DIRECT_URL=postgresql://user:password@ep-your-db.region.neon.tech/neondb?sslmode=require

# Google Gemini API Key and Model Identifiers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Public URL of this API (used for file URLs and callbacks)
# Example: https://evolyn-api.onrender.com or https://evolyn-api.up.railway.app
API_BASE_URL=http://localhost:5001

# Allowed Origins for CORS (Comma-separated or * for public API)
CORS_ORIGIN=*

